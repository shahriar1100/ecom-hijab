# ============================================================================
# NOOR Hijab E-Commerce — Environment Variables (.env.local)
# Copy this file to `.env.local` and fill in your Supabase & Cloudinary keys.
# ============================================================================

# 1. Supabase (PostgreSQL Database)
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Cloudinary (Fast Image Upload & Global CDN)
# Get these from: Cloudinary Dashboard -> Settings -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# 3. Admin Panel Login Credentials (/admin)
ADMIN_EMAIL=admin@noor.com
ADMIN_PASSWORD=noor-admin-2026
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret-string

# 4. Email / SMTP Configuration (for Customer Password Reset & Notifications)
# Option A: Standard SMTP (Gmail App Password, cPanel Webmail, Amazon SES, Brevo, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="NOOR Modest Wear" <your-email@gmail.com>

# Option B: Resend API (Alternative fast transactional email)
# RESEND_API_KEY=re_123456789...
